# Frontend
NEXT_PUBLIC_API_BASE_URL=/api/backend
BACKEND_INTERNAL_URL=http://127.0.0.1:8011

# Backend, used in later MVP/V1 stages
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai

AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
CITY_ROUTE_USE_AMAP=true

# Optional. Used by frontend map visualization. If empty, app shows local coordinate sketch.
NEXT_PUBLIC_AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=

# DeepSeek itinerary explanation. Empty key keeps local fallback enabled.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
CITY_ROUTE_USE_DEEPSEEK=true

# Local account token signing. Replace before public deployment.
CITY_ROUTE_AUTH_SECRET=change-this-local-secret
CITY_ROUTE_AUTH_TOKEN_TTL_SECONDS=2592000
CITY_ROUTE_LOGIN_MAX_ATTEMPTS=5
CITY_ROUTE_LOGIN_WINDOW_SECONDS=900
CITY_ROUTE_POI_RATE_LIMIT_MAX_REQUESTS=60
CITY_ROUTE_POI_RATE_LIMIT_WINDOW_SECONDS=60
CITY_ROUTE_ROUTE_RATE_LIMIT_MAX_REQUESTS=12
CITY_ROUTE_ROUTE_RATE_LIMIT_WINDOW_SECONDS=60
CITY_ROUTE_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Persistence. Use json for local file storage, mysql for MySQL storage.
CITY_ROUTE_USE_PERSISTENCE=true
CITY_ROUTE_STORAGE_BACKEND=json
CITY_ROUTE_STORAGE_PATH=backend/data/store.json

# Required when CITY_ROUTE_STORAGE_BACKEND=mysql.
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/city_route_mvp
