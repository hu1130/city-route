# Frontend
NEXT_PUBLIC_API_BASE_URL=/api/backend
BACKEND_INTERNAL_URL=http://backend:8011

# Runtime
APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
CITY_ROUTE_CORS_ORIGINS=https://example.com
CITY_ROUTE_LOG_LEVEL=INFO

# Public host and operations
CITY_ROUTE_DOMAIN=example.com
MONITOR_INTERVAL_SECONDS=60
MONITOR_FAILURE_THRESHOLD=3
ALERT_WEBHOOK_URL=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Amap
AMAP_API_KEY=replace-with-amap-web-service-key
AMAP_BASE_URL=https://restapi.amap.com
CITY_ROUTE_USE_AMAP=true
NEXT_PUBLIC_AMAP_JS_KEY=replace-with-amap-js-key
AMAP_SECURITY_JS_CODE=replace-with-amap-js-security-code

# DeepSeek
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
CITY_ROUTE_USE_DEEPSEEK=true

# Auth
CITY_ROUTE_AUTH_SECRET=replace-with-random-64-plus-character-secret
CITY_ROUTE_AUTH_TOKEN_TTL_SECONDS=2592000
CITY_ROUTE_LOGIN_MAX_ATTEMPTS=5
CITY_ROUTE_LOGIN_WINDOW_SECONDS=900
CITY_ROUTE_POI_RATE_LIMIT_MAX_REQUESTS=60
CITY_ROUTE_POI_RATE_LIMIT_WINDOW_SECONDS=60
CITY_ROUTE_ROUTE_RATE_LIMIT_MAX_REQUESTS=12
CITY_ROUTE_ROUTE_RATE_LIMIT_WINDOW_SECONDS=60

# Persistence
CITY_ROUTE_USE_PERSISTENCE=true
CITY_ROUTE_STORAGE_BACKEND=mysql
MYSQL_DATABASE=city_route_mvp
MYSQL_USER=city_route
MYSQL_PASSWORD=replace-with-url-safe-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DATABASE_URL=mysql+pymysql://city_route:replace-with-url-safe-password@mysql:3306/city_route_mvp
